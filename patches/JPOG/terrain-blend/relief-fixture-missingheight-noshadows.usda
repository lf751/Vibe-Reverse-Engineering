#usda 1.0
(
    defaultPrim = "RootNode"
    customLayerData = { string remix_replacement_status = "Terrain blend smoke fixture" }
)

def Xform "RootNode"
{
    def Scope "TerrainBlend"
    {
        custom bool remix:terrainBlend:displacementEnabled = true
        custom float remix:terrainBlend:displacementStrength = 1
        custom int remix:terrainBlend:displacementMaxIterations = 64
        custom float4 remix:terrainBlend:displacementInward = (1, 0, 0, 0)
        custom float4 remix:terrainBlend:displacementOutward = (1, 0, 0, 0)
        custom float4 remix:terrainBlend:displacementHeightMin = (0, 0, 0, 0)
        custom float4 remix:terrainBlend:displacementHeightMax = (1, 1, 1, 1)
        custom bool remix:terrainBlend:displacementSelfShadowEnabled = false
        custom float remix:terrainBlend:displacementShadowStrength = 1
        custom int remix:terrainBlend:displacementShadowMaxIterations = 32
        custom int remix:terrainBlend:schemaVersion = 1
        custom bool remix:terrainBlend:enabled = true
        custom float3 remix:terrainBlend:unitsPerRepeat = (8, 8, 8)
        custom float remix:terrainBlend:lowElevation = -1000
        custom float remix:terrainBlend:highElevation = -999
        custom float remix:terrainBlend:slopeStartDegrees = 85
        custom float remix:terrainBlend:slopeEndDegrees = 90
        custom float remix:terrainBlend:heightBlendStrength = 0
        custom float remix:terrainBlend:heightBlendWidth = 0.2
        custom float remix:terrainBlend:dirtStrength = 0
        custom float remix:terrainBlend:dirtWidth = 3
        custom float remix:terrainBlend:dirtMinElevation = -1000
        custom float remix:terrainBlend:dirtElevationFadeWidth = 1
        custom float remix:terrainBlend:dirtUnitsPerRepeat = 8
        custom rel remix:terrainBlend:dirtMaterial = </RootNode/TerrainBlend/dirt>
        custom rel remix:terrainBlend:grassMaterial = </RootNode/TerrainBlend/grass>
        custom rel remix:terrainBlend:sandMaterial = </RootNode/TerrainBlend/sand>
        custom rel remix:terrainBlend:rockMaterial = </RootNode/TerrainBlend/rock>

        def Material "grass"
        {
            token outputs:mdl:surface.connect = </RootNode/TerrainBlend/grass/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                color3f inputs:diffuse_color_constant = (1, 1, 1)
                asset inputs:diffuse_texture = @D:/Unity/Vibe-Reverse-Engineering_JPOG_BetaTools/patches/JPOG/terrain-blend/pom-smoke/albedo.dds@
                float inputs:reflection_roughness_constant = 0.9
                token outputs:out
            }
        }
        def Material "sand"
        {
            token outputs:mdl:surface.connect = </RootNode/TerrainBlend/sand/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                color3f inputs:diffuse_color_constant = (0.65, 0.45, 0.2)
                float inputs:reflection_roughness_constant = 0.8
                token outputs:out
            }
        }
        def Material "dirt"
        {
            token outputs:mdl:surface.connect = </RootNode/TerrainBlend/dirt/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                color3f inputs:diffuse_color_constant = (0.45, 0.04, 0.3)
                float inputs:reflection_roughness_constant = 0.8
                token outputs:out
            }
        }
        def Material "rock"
        {
            token outputs:mdl:surface.connect = </RootNode/TerrainBlend/rock/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                color3f inputs:diffuse_color_constant = (0.3, 0.3, 0.3)
                float inputs:reflection_roughness_constant = 0.75
                token outputs:out
            }
        }
    }
}




