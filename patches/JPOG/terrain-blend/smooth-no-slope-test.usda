                asset inputs:diffuse_texture = @C:\Users\User\Desktop\Files\JPOGRTX\assets\ingested\Terrain\coast_sand_02_diff_2k.a.rtex.dds@
                asset inputs:height_texture = @C:\Users\User\Desktop\Files\JPOGRTX\assets\ingested\Terrain\coast_sand_02_disp_2k.h.rtex.dds@
                float inputs:metallic_constant = 0
