                float inputs:metallic_constant = 0
                asset inputs:normalmap_texture = @C:\Users\User\Desktop\Files\JPOGRTX\assets\ingested\Terrain\coast_land_rocks_01_nor_gl_2k_OTH_Normal.n.rtex.dds@
                float inputs:opacity_constant = 1
                float inputs:reflection_roughness_constant = 0.7
                asset inputs:reflectionroughness_texture = @C:\Users\User\Desktop\Files\JPOGRTX\assets\ingested\Terrain\coast_land_rocks_01_rough_2k.r.rtex.dds@
                bool inputs:use_legacy_alpha_state = 0
                token outputs:out
            }
        }

        def Material "rock"
        {
            token outputs:mdl:surface.connect = </RootNode/TerrainBlend/rock/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
