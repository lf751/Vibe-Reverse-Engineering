/* ---- Intercepted methods ---- */

/* 16: Reset */
static int __stdcall WD_Reset(WrappedDevice *self, void *pPresentParams) {
    typedef int (__stdcall *FN)(void*, void*);
    int hr;
    log_str("== Device Reset ==\r\n");
    self->mvDirty = 0;
    self->mvpDirty = 0;
    self->viewCapturedThisFrame = 0;
    self->hasCachedWorld = 0;
    self->gameWorldSet = 0;
    hr = ((FN)RealVtbl(self)[SLOT_Reset])(self->pReal, pPresentParams);
    log_hex("  Reset hr=", hr);
    return hr;
}

/* 17: Present — end of frame */
static int __stdcall WD_Present(WrappedDevice *self, void *a, void *b, void *c, void *d) {
    typedef int (__stdcall *FN)(void*, void*, void*, void*, void*);
    int hr;

#if DIAG_ENABLED
    if (DIAG_ACTIVE(self)) {
        log_str("==== PRESENT frame ");
        log_int("", self->frameCount);
        log_int("  drawCalls: ", self->drawCallCount);
        diag_log_matrix("  VIEW", self->viewMatrix);
        log_int("  hasRealView: ", self->hasRealView);
        diag_log_matrix("  last MV", self->mvMatrix);
        log_int("  vbSamples: ", g_vbSampleCount);
        log_int("  centroidOverrides(worldBaked): ", g_centroidOverrides);
        log_int("  centroidMisses(noSample): ", g_centroidMisses);
        log_int("  centroidNoVB: ", g_centroidNoVB);
        log_int("  svcfMvWrites: ", g_svcfMvWrites);
        log_int("  svcfMvpWrites: ", g_svcfMvpWrites);
        log_int("  hasProj: ", self->hasProj);
        log_int("  mvpWorldExtracts(modelSpace): ", g_mvpWorldExtracts);
        log_int("  gameWorldSets(suppressed): ", g_gameWorldSets);
        log_hex("  curStream0VB: ", (unsigned int)(size_t)g_curStream0VB);
        self->diagLoggedFrames++;
    }
#endif

    hr = ((FN)RealVtbl(self)[SLOT_Present])(self->pReal, a, b, c, d);

    self->frameCount++;
    self->drawCallCount = 0;
    self->mvDirty = 0;
    self->mvpDirty = 0;
    self->viewCapturedThisFrame = 0;
    self->hasCachedWorld = 0;
    self->gameWorldSet = 0;
    g_centroidOverrides = 0;
    g_centroidMisses    = 0;
    g_centroidNoVB      = 0;
    g_centroidNearOrigin= 0;
    g_svcfMvWrites      = 0;
    g_svcfMvpWrites     = 0;
    g_gameWorldSets     = 0;
    g_ffpDraws          = 0;
    g_mvpWorldExtracts  = 0;
    g_gameWorldDraws    = 0;

    return hr;
}

/* 41: BeginScene */
static int __stdcall WD_BeginScene(WrappedDevice *self) {
    typedef int (__stdcall *FN)(void*);
    self->sceneCount++;
    return ((FN)RealVtbl(self)[SLOT_BeginScene])(self->pReal);
}

/* 42: EndScene */
static int __stdcall WD_EndScene(WrappedDevice *self) {
    typedef int (__stdcall *FN)(void*);
    return ((FN)RealVtbl(self)[SLOT_EndScene])(self->pReal);
}

/* 44: SetTransform — detect real View from ASI, suppress game's WORLD writes */
static int __stdcall WD_SetTransform(WrappedDevice *self, unsigned int state, float *pMatrix) {
    typedef int (__stdcall *FN)(void*, unsigned int, float*);

    if (state == D3DTS_VIEW && pMatrix) {
        if (mat4_isIdentity(pMatrix)) {
            /* Game's default identity VIEW — suppress */
            return 0;
        }
        /* Real View from ASI hook — capture and forward to Remix */
        memcpy(self->viewMatrix, pMatrix, 16 * sizeof(float));
        mat4_invOrthogonal(self->invViewMatrix, self->viewMatrix);
        self->viewCapturedThisFrame = 1;
        self->hasRealView = 1;

#if DIAG_ENABLED
        if (DIAG_ACTIVE(self)) {
            log_str("  ASI real VIEW received\r\n");
            diag_log_matrix("    VIEW", self->viewMatrix);
        }
#endif
        {
            float copy[16];
            memcpy(copy, self->viewMatrix, 16 * sizeof(float));
            return ((FN)RealVtbl(self)[SLOT_SetTransform])(self->pReal, D3DTS_VIEW, copy);
        }
    }

    /* Capture Projection matrix for MVP decomposition */
    if (state == D3DTS_PROJECTION && pMatrix) {
        memcpy(self->projMatrix, pMatrix, 16 * sizeof(float));
        self->hasProj = 1;
        self->invProjDirty = 1;
    }

    /* Game/dxwrapper D3DTS_WORLD writes: suppress. We set our own WORLD from
       MVP × inv(P) × inv(V) before each draw in ApplyTransforms. */
    if (state >= 256 && state < 512) {
        g_gameWorldSets++;
#if DIAG_ENABLED
        if (DIAG_ACTIVE(self)) {
            log_int("  game SetTransform(WORLD) #", g_gameWorldSets);
        }
#endif
        memcpy(self->gameWorldMatrix, pMatrix, 16 * sizeof(float));
        self->gameWorldSet = 1;
        self->hasCachedWorld = 0;
        return 0;
    }

    return ((FN)RealVtbl(self)[SLOT_SetTransform])(self->pReal, state, pMatrix);
}

/* 86: CreateVertexDeclaration — create original + FFP-remapped version */
static int __stdcall WD_CreateVertexDeclaration(WrappedDevice *self,
    D3DVERTEXELEMENT9 *pVertexElements, void **ppDecl)
{
    typedef int (__stdcall *FN)(void*, D3DVERTEXELEMENT9*, void**);
    D3DVERTEXELEMENT9 ffpElems[32];
    void *pFFPDecl = NULL;
    int hr, i, count, needsRemap;
    int texIdx = 0, colorIdx = 0, hasNormal = 0;

    hr = ((FN)RealVtbl(self)[SLOT_CreateVertexDeclaration])(
        self->pReal, pVertexElements, ppDecl);
    if (hr != 0 || !ppDecl || !*ppDecl) return hr;

    /* Count elements and detect mismatched semantics */
    count = 0;
    needsRemap = 0;
    while (pVertexElements[count].Stream != 0xFF && count < 30) {
        unsigned char u = pVertexElements[count].Usage;
        unsigned char t = pVertexElements[count].Type;
        if (u == D3DDECLUSAGE_BLENDWEIGHT || u == D3DDECLUSAGE_BLENDINDICES ||
            (u == D3DDECLUSAGE_PSIZE  && t == D3DDECLTYPE_FLOAT2) ||
            (u == D3DDECLUSAGE_NORMAL && t == D3DDECLTYPE_D3DCOLOR))
            needsRemap = 1;
        count++;
    }

    if (g_ffpDeclCount >= FFP_DECL_MAX) return hr;

    if (!needsRemap) {
        g_ffpDecls[g_ffpDeclCount].pOrigDecl = *ppDecl;
        g_ffpDecls[g_ffpDeclCount].pFFPDecl  = *ppDecl;
        g_ffpDecls[g_ffpDeclCount].elemCount = (unsigned int)count;
        g_ffpDecls[g_ffpDeclCount].ffpEligible = (count == 3);
        g_ffpDeclCount++;
        return hr;
    }

    /* Build remapped declaration with FFP-compatible semantics */
    for (i = 0; i < count; i++) {
        ffpElems[i] = pVertexElements[i];
        switch (ffpElems[i].Usage) {
        case D3DDECLUSAGE_BLENDWEIGHT:
            if (ffpElems[i].Type == D3DDECLTYPE_D3DCOLOR) {
                ffpElems[i].Usage = D3DDECLUSAGE_COLOR;
                ffpElems[i].UsageIndex = (unsigned char)colorIdx++;
            } else if (ffpElems[i].Type == D3DDECLTYPE_FLOAT3 && !hasNormal) {
                ffpElems[i].Usage = D3DDECLUSAGE_NORMAL;
                ffpElems[i].UsageIndex = 0;
                hasNormal = 1;
            }
            break;
        case D3DDECLUSAGE_BLENDINDICES:
            if (ffpElems[i].Type == D3DDECLTYPE_FLOAT2) {
                ffpElems[i].Usage = D3DDECLUSAGE_TEXCOORD;
                ffpElems[i].UsageIndex = (unsigned char)texIdx++;
            } else if (ffpElems[i].Type == D3DDECLTYPE_D3DCOLOR) {
                ffpElems[i].Usage = D3DDECLUSAGE_COLOR;
                ffpElems[i].UsageIndex = (unsigned char)colorIdx++;
            }
            break;
        case D3DDECLUSAGE_NORMAL:
            if (ffpElems[i].Type == D3DDECLTYPE_D3DCOLOR) {
                ffpElems[i].Usage = D3DDECLUSAGE_COLOR;
                ffpElems[i].UsageIndex = (unsigned char)colorIdx++;
            } else {
                hasNormal = 1;
            }
            break;
        case D3DDECLUSAGE_PSIZE:
            if (ffpElems[i].Type == D3DDECLTYPE_FLOAT2) {
                ffpElems[i].Usage = D3DDECLUSAGE_TEXCOORD;
                ffpElems[i].UsageIndex = (unsigned char)texIdx++;
            }
            break;
        case D3DDECLUSAGE_TEXCOORD:
            texIdx = ffpElems[i].UsageIndex + 1;
            break;
        case D3DDECLUSAGE_COLOR:
            colorIdx = ffpElems[i].UsageIndex + 1;
            break;
        }
    }

    /* End sentinel */
    ffpElems[count].Stream = 0xFF;
    ffpElems[count].Offset = 0;
    ffpElems[count].Type = D3DDECLTYPE_UNUSED;
    ffpElems[count].Method = 0;
    ffpElems[count].Usage = 0;
    ffpElems[count].UsageIndex = 0;

    ((FN)RealVtbl(self)[SLOT_CreateVertexDeclaration])(
        self->pReal, ffpElems, &pFFPDecl);

    g_ffpDecls[g_ffpDeclCount].pOrigDecl = *ppDecl;
    g_ffpDecls[g_ffpDeclCount].pFFPDecl  = pFFPDecl ? pFFPDecl : *ppDecl;
    g_ffpDecls[g_ffpDeclCount].elemCount = (unsigned int)count;
    g_ffpDecls[g_ffpDeclCount].ffpEligible = (count == 3);
    g_ffpDeclCount++;

    return hr;
}

/* 87: SetVertexDeclaration — track current declaration for FFP swap */
static int __stdcall WD_SetVertexDeclaration(WrappedDevice *self, void *pDecl)
{
    typedef int (__stdcall *FN)(void*, void*);
    g_currentDecl = pDecl;
    return ((FN)RealVtbl(self)[SLOT_SetVertexDeclaration])(self->pReal, pDecl);
}

/* 81: DrawPrimitive */
static int __stdcall WD_DrawPrimitive(WrappedDevice *self,
    unsigned int pt, unsigned int sv, unsigned int pc)
{
    typedef int (__stdcall *FN)(void*, unsigned int, unsigned int, unsigned int);
    typedef int (__stdcall *FN_SS)(void*, void*);
    int useFfp, hr;
    FFPDeclEntry *pDeclInfo = NULL;
    void *pFFP = NULL;
    self->drawCallCount++;

    pDeclInfo = ffpDecl_lookup(g_currentDecl);
    useFfp = pDeclInfo && pDeclInfo->ffpEligible;

    if (useFfp) {
        ApplyTransforms(self, sv, pc * 3, pc);
        useFfp = self->hasCachedWorld;
    }

    if (useFfp) {
        pFFP = pDeclInfo->pFFPDecl;
        if (pFFP && pFFP != g_currentDecl)
            ((FN_SS)RealVtbl(self)[SLOT_SetVertexDeclaration])(self->pReal, pFFP);
        ((FN_SS)RealVtbl(self)[SLOT_SetVertexShader])(self->pReal, NULL);
        {
            typedef int (__stdcall *FN_RS)(void*, unsigned int, unsigned int);
            ((FN_RS)RealVtbl(self)[SLOT_SetRenderState])(self->pReal,
                D3DRS_LIGHTING, 0);
        }
        g_ffpDraws++;
    }

#if DIAG_ENABLED
    if (DIAG_ACTIVE(self) && (self->drawCallCount <= 5 || useFfp)) {
        log_int("  DP #", self->drawCallCount);
        log_int("    type=", pt);
        log_int("    primCount=", pc);
        log_int("    ffp=", useFfp);
        if (useFfp) {
            log_hex("    vb=", (unsigned int)(size_t)g_curStream0VB);
            log_int("    path=", g_lastWorldPath);
            log_float_val("    cx=", g_lastCentroid[0]);
            log_float_val("    cy=", g_lastCentroid[1]);
            log_float_val("    cz=", g_lastCentroid[2]);
            log_float_val("    world tx=", self->cachedWorld[12]);
            log_float_val("    world ty=", self->cachedWorld[13]);
            log_float_val("    world tz=", self->cachedWorld[14]);
            if (g_lastWorldPath == 2)
                log_int("  mvpWorld draw#", self->drawCallCount);
            diag_log_matrix("    WORLD", self->cachedWorld);
        }
        diag_log_matrix("    MV", self->mvMatrix);
    }
#endif

    hr = ((FN)RealVtbl(self)[SLOT_DrawPrimitive])(self->pReal, pt, sv, pc);

    if (useFfp && pFFP && pFFP != g_currentDecl)
        ((FN_SS)RealVtbl(self)[SLOT_SetVertexDeclaration])(self->pReal, g_currentDecl);

    return hr;
}

/* 82: DrawIndexedPrimitive */
static int __stdcall WD_DrawIndexedPrimitive(WrappedDevice *self,
    unsigned int pt, int bvi, unsigned int mi, unsigned int nv,
    unsigned int si, unsigned int pc)
{
    typedef int (__stdcall *FN)(void*, unsigned int, int, unsigned int,
                                unsigned int, unsigned int, unsigned int);
    typedef int (__stdcall *FN_SS)(void*, void*);
    int hr;
    int useFfp;
    FFPDeclEntry *pDeclInfo = NULL;
    void *pFFP = NULL;

    self->drawCallCount++;

    pDeclInfo = ffpDecl_lookup(g_currentDecl);
    useFfp = pDeclInfo && pDeclInfo->ffpEligible;

    if (useFfp) {
        unsigned int streamStart = bvi < 0 ? 0u : (unsigned int)bvi;
        ApplyTransforms(self, streamStart, nv, pc);
        useFfp = self->hasCachedWorld;
    }

    if (useFfp) {
        pFFP = pDeclInfo->pFFPDecl;
        if (pFFP && pFFP != g_currentDecl)
            ((FN_SS)RealVtbl(self)[SLOT_SetVertexDeclaration])(self->pReal, pFFP);
        ((FN_SS)RealVtbl(self)[SLOT_SetVertexShader])(self->pReal, NULL);
        {
            typedef int (__stdcall *FN_RS)(void*, unsigned int, unsigned int);
            ((FN_RS)RealVtbl(self)[SLOT_SetRenderState])(self->pReal,
                D3DRS_LIGHTING, 0);
        }
        g_ffpDraws++;
    }

#if DIAG_ENABLED
    if (DIAG_ACTIVE(self) && (self->drawCallCount <= 5 || useFfp)) {
        log_int("  DIP #", self->drawCallCount);
        log_int("    type=", pt);
        log_int("    baseVtx=", bvi);
        log_int("    numVerts=", nv);
        log_int("    primCount=", pc);
        log_int("    ffp=", useFfp);
        if (useFfp) {
            log_hex("    vb=", (unsigned int)(size_t)g_curStream0VB);
            log_int("    path=", g_lastWorldPath);
            log_float_val("    cx=", g_lastCentroid[0]);
            log_float_val("    cy=", g_lastCentroid[1]);
            log_float_val("    cz=", g_lastCentroid[2]);
            log_float_val("    world tx=", self->cachedWorld[12]);
            log_float_val("    world ty=", self->cachedWorld[13]);
            log_float_val("    world tz=", self->cachedWorld[14]);
            if (g_lastWorldPath == 2)
                log_int("  mvpWorld draw#", self->drawCallCount);
            diag_log_matrix("    WORLD", self->cachedWorld);
        }
        diag_log_matrix("    MV", self->mvMatrix);
    }
#endif

    hr = ((FN)RealVtbl(self)[SLOT_DrawIndexedPrimitive])(self->pReal,
        pt, bvi, mi, nv, si, pc);

    if (useFfp && pFFP && pFFP != g_currentDecl)
        ((FN_SS)RealVtbl(self)[SLOT_SetVertexDeclaration])(self->pReal, g_currentDecl);

    return hr;
}

/* 94: SetVertexShaderConstantF — capture c17-c20 (transposed ModelView) */
static int __stdcall WD_SetVertexShaderConstantF(WrappedDevice *self,
    unsigned int startReg, float *pData, unsigned int count)
{
    typedef int (__stdcall *FN)(void*, unsigned int, float*, unsigned int);

    if (pData) {
        unsigned int endReg = startReg + count;

        /* New constant data in c0-c3 range means new object — invalidate cache */
        if (startReg < 4 && endReg > 0) {
            self->hasCachedWorld = 0;
            self->gameWorldSet = 0;

            /* Capture complete MVP (c0-c3, transposed to row-major) */
            if (startReg == 0 && endReg >= 4) {
                mat4_transpose(self->mvpMatrix, pData);
                self->mvpDirty = 1;
                g_svcfMvpWrites++;
            }
        }

        /* Capture c17-c20 (transposed ModelView) */
        if (startReg < VS_REG_MV_END && endReg > VS_REG_MV_START) {
            unsigned int mvOff;
            if (startReg <= VS_REG_MV_START && endReg >= VS_REG_MV_END) {
                float *mvSrc = pData + (VS_REG_MV_START - startReg) * 4;
                mat4_transpose(self->mvMatrix, mvSrc);
                self->mvDirty = 1;
            } else {
                float raw[16];
                unsigned int r;
                mat4_transpose(raw, self->mvMatrix);
                for (r = startReg; r < endReg; r++) {
                    if (r >= VS_REG_MV_START && r < VS_REG_MV_END) {
                        mvOff = (r - VS_REG_MV_START) * 4;
                        raw[mvOff + 0] = pData[(r - startReg) * 4 + 0];
                        raw[mvOff + 1] = pData[(r - startReg) * 4 + 1];
                        raw[mvOff + 2] = pData[(r - startReg) * 4 + 2];
                        raw[mvOff + 3] = pData[(r - startReg) * 4 + 3];
                    }
                }
                mat4_transpose(self->mvMatrix, raw);
                self->mvDirty = 1;
            }
            g_svcfMvWrites++;
        }
    }

    return ((FN)RealVtbl(self)[SLOT_SetVertexShaderConstantF])(self->pReal,
        startReg, pData, count);
}

/* ---- Build vtable ---- */

WrappedDevice* WrappedDevice_Create(void *pRealDevice) {
    WrappedDevice *w;
    int i;

    w = (WrappedDevice*)HeapAlloc(GetProcessHeap(), 8 /*HEAP_ZERO_MEMORY*/,
                                  sizeof(WrappedDevice));
    if (!w) return NULL;

    s_device_vtbl[0]  = (void*)WD_QueryInterface;
    s_device_vtbl[1]  = (void*)WD_AddRef;
    s_device_vtbl[2]  = (void*)WD_Release;
    s_device_vtbl[3]  = (void*)Relay_03;
    s_device_vtbl[4]  = (void*)Relay_04;
    s_device_vtbl[5]  = (void*)Relay_05;
    s_device_vtbl[6]  = (void*)Relay_06;
    s_device_vtbl[7]  = (void*)Relay_07;
    s_device_vtbl[8]  = (void*)Relay_08;
    s_device_vtbl[9]  = (void*)Relay_09;
    s_device_vtbl[10] = (void*)Relay_10;
    s_device_vtbl[11] = (void*)Relay_11;
    s_device_vtbl[12] = (void*)Relay_12;
    s_device_vtbl[13] = (void*)Relay_13;
    s_device_vtbl[14] = (void*)Relay_14;
    s_device_vtbl[15] = (void*)Relay_15;
    s_device_vtbl[16] = (void*)WD_Reset;                     /* INTERCEPTED */
    s_device_vtbl[17] = (void*)WD_Present;                   /* INTERCEPTED */
    s_device_vtbl[18] = (void*)Relay_18;
    s_device_vtbl[19] = (void*)Relay_19;
    s_device_vtbl[20] = (void*)Relay_20;
    s_device_vtbl[21] = (void*)Relay_21;
    s_device_vtbl[22] = (void*)Relay_22;
    s_device_vtbl[23] = (void*)Relay_23;
    s_device_vtbl[24] = (void*)Relay_24;
    s_device_vtbl[25] = (void*)Relay_25;
    s_device_vtbl[26] = (void*)WD_CreateVertexBuffer;        /* INTERCEPTED */
    s_device_vtbl[27] = (void*)Relay_27;
    s_device_vtbl[28] = (void*)Relay_28;
    s_device_vtbl[29] = (void*)Relay_29;
    s_device_vtbl[30] = (void*)Relay_30;
    s_device_vtbl[31] = (void*)Relay_31;
    s_device_vtbl[32] = (void*)Relay_32;
    s_device_vtbl[33] = (void*)Relay_33;
    s_device_vtbl[34] = (void*)Relay_34;
    s_device_vtbl[35] = (void*)Relay_35;
    s_device_vtbl[36] = (void*)Relay_36;
    s_device_vtbl[37] = (void*)Relay_37;
    s_device_vtbl[38] = (void*)Relay_38;
    s_device_vtbl[39] = (void*)Relay_39;
    s_device_vtbl[40] = (void*)Relay_40;
    s_device_vtbl[41] = (void*)WD_BeginScene;                /* INTERCEPTED */
    s_device_vtbl[42] = (void*)WD_EndScene;                  /* INTERCEPTED */
    s_device_vtbl[43] = (void*)Relay_43;
    s_device_vtbl[44] = (void*)WD_SetTransform;              /* INTERCEPTED */
    s_device_vtbl[45] = (void*)Relay_45;
    s_device_vtbl[46] = (void*)Relay_46;
    s_device_vtbl[47] = (void*)Relay_47;
    s_device_vtbl[48] = (void*)Relay_48;
    s_device_vtbl[49] = (void*)Relay_49;
    s_device_vtbl[50] = (void*)Relay_50;
    s_device_vtbl[51] = (void*)Relay_51;
    s_device_vtbl[52] = (void*)Relay_52;
    s_device_vtbl[53] = (void*)Relay_53;
    s_device_vtbl[54] = (void*)Relay_54;
    s_device_vtbl[55] = (void*)Relay_55;
    s_device_vtbl[56] = (void*)Relay_56;
    s_device_vtbl[57] = (void*)Relay_57;
    s_device_vtbl[58] = (void*)Relay_58;
    s_device_vtbl[59] = (void*)Relay_59;
    s_device_vtbl[60] = (void*)Relay_60;
    s_device_vtbl[61] = (void*)Relay_61;
    s_device_vtbl[62] = (void*)Relay_62;
    s_device_vtbl[63] = (void*)Relay_63;
    s_device_vtbl[64] = (void*)Relay_64;
    s_device_vtbl[65] = (void*)Relay_65;
    s_device_vtbl[66] = (void*)Relay_66;
    s_device_vtbl[67] = (void*)Relay_67;
    s_device_vtbl[68] = (void*)Relay_68;
